<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AB System Quiz™</title>

    <script>
      !(function (f, b, e, v, n, t, s) {
        if (f.fbq) return;
        n = f.fbq = function () {
          n.callMethod
            ? n.callMethod.apply(n, arguments)
            : n.queue.push(arguments);
        };
        if (!f._fba) f._fbq = n;
        n.push = n;
        n.loaded = !0;
        n.version = "2.0";
        n.queue = [];
        t = b.createElement(e);
        t.async = !0;
        t.src = v;
        s = b.getElementsByTagName(e)[0];
        s.parentNode.insertBefore(t, s);
      })(
        window,
        document,
        "script",
        "https://connect.facebook.net/en_US/fbevents.js",
      );
      fbq("init", "183891268720873");
    </script>
    <noscript
      ><img
        height="1"
        width="1"
        style="display: none"
        src="https://www.facebook.com/tr?id=183891268720873&ev=PageView&noscript=1"
    /></noscript>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Inter:wght@200;300;400;500;600;700;900&display=swap"
      rel="stylesheet"
    />
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>

    <style>
      :root {
        --color-indigo: #011963;
        --color-cobalt: #0a56c6;
        --color-bone: #f0f2da;
        --color-white: #ffffff;
        --color-graphite: #262626;
        --color-danger: #b93d3d;
        --color-warning: #e67e22;
        --color-success: #1abc9c;
        --text-strong: #102a63;
        --text-body: #243447;
        --text-muted: #64748b;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: "Inter", sans-serif;
        background: #f0f2da;
        color: var(--color-graphite);
      }

      .font-mono {
        font-family: "IBM Plex Mono", monospace;
      }

      .app-shell {
        min-height: 100vh;
      }

      #brand-logo {
        height: 2.4rem;
        width: auto;
      }

      .screen {
        max-width: 740px;
        margin: 0 auto;
        padding: 7rem 1rem 2.2rem;
      }

      body.mode-intro .screen {
        max-width: none;
        padding: 0;
      }

      .card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 1rem;
        box-shadow: 0 8px 20px rgba(1, 25, 99, 0.06);
      }

      .intro-box {
        padding: 1.4rem;
      }

      .blob {
        position: absolute;
        filter: blur(80px);
        z-index: 0;
        opacity: 0.4;
      }

      .fade-in {
        animation: fadeIn 0.5s ease-out forwards;
        opacity: 0;
      }

      @keyframes fadeIn {
        from {
          opacity: 0;
          transform: translateY(10px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      .kicker {
        font-size: 0.7rem;
        letter-spacing: 0.14em;
        font-weight: 700;
        color: var(--color-cobalt);
        margin: 0 0 0.7rem;
      }

      .title {
        margin: 0;
        font-size: 1.8rem;
        line-height: 1.24;
        color: var(--color-indigo);
        font-weight: 700;
      }

      .subtitle {
        margin: 0.7rem 0 0;
        font-size: 1rem;
        line-height: 1.55;
        color: #4b5563;
      }

      .intro-note {
        margin-top: 0.8rem;
        font-size: 0.8rem;
        color: #6b7280;
      }

      .skyline {
        display: flex;
        align-items: flex-end;
        justify-content: center;
        gap: 0.22rem;
        height: 4rem;
        margin: 1rem 0 1.15rem;
      }

      .skyline-bar {
        width: 0.36rem;
        border-radius: 3px 3px 0 0;
        opacity: 0.86;
      }

      .btn-primary {
        width: 100%;
        background: var(--color-cobalt);
        color: #fff;
        border: 0;
        border-radius: 0.7rem;
        padding: 0.85rem 1rem;
        font-size: 0.98rem;
        font-weight: 700;
        cursor: pointer;
      }

      .btn-primary:hover {
        background: var(--color-indigo);
      }

      .btn-secondary {
        background: transparent;
        color: var(--color-cobalt);
        border: 1px solid var(--color-cobalt);
        border-radius: 0.65rem;
        padding: 0.72rem 0.95rem;
        font-size: 0.9rem;
        font-weight: 600;
        cursor: pointer;
      }

      .btn-ghost {
        background: transparent;
        color: #6b7280;
        border: 1px solid #d1d5db;
        border-radius: 0.65rem;
        padding: 0.72rem 0.95rem;
        font-size: 0.9rem;
        font-weight: 600;
        cursor: pointer;
      }

      .question-wrap {
        padding: 1.28rem;
      }

      .question-stage {
        min-height: calc(100vh - 11rem);
        display: flex;
        align-items: flex-start;
      }

      .question-stage .question-wrap {
        width: 100%;
        margin-top: 3.1rem;
      }

      .progress-track {
        width: 100%;
        height: 0.37rem;
        border-radius: 999px;
        background: #dbeafe;
        overflow: hidden;
      }

      .progress-fill {
        height: 100%;
        background: var(--color-cobalt);
        transition: width 0.25s;
      }

      .q-top {
        margin-top: 0.95rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .q-tag {
        font-size: 0.69rem;
        font-weight: 600;
        letter-spacing: 0.04em;
        color: var(--color-cobalt);
      }

      .q-counter {
        font-size: 0.72rem;
        color: var(--text-muted);
        font-weight: 500;
      }

      .axis-dots {
        display: flex;
        gap: 0.32rem;
        margin-top: 0.7rem;
      }

      .axis-stepper-wrap {
        margin-top: 0.72rem;
      }

      .axis-stepper-title {
        margin: 0;
        color: var(--text-muted);
        font-size: 0.7rem;
        font-weight: 500;
        letter-spacing: 0.02em;
      }

      .axis-stepper {
        margin-top: 0.44rem;
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 0.34rem;
      }

      .axis-step {
        border: 1px solid #dbe3ee;
        border-radius: 0.56rem;
        background: #f8fafc;
        min-height: 2rem;
        display: flex;
        align-items: center;
        gap: 0.36rem;
        padding: 0.28rem 0.42rem;
        transition:
          border-color 0.2s ease,
          box-shadow 0.2s ease,
          opacity 0.2s ease;
      }

      .axis-step.done {
        opacity: 0.66;
      }

      .axis-step.active {
        border-color: var(--axis-color);
        box-shadow: 0 0 0 1px var(--axis-color);
        background: #ffffff;
      }

      .axis-step-index {
        width: 1.05rem;
        height: 1.05rem;
        border-radius: 999px;
        background: #d1d5db;
        color: #475569;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 0.62rem;
        font-weight: 800;
        flex-shrink: 0;
      }

      .axis-step.done .axis-step-index {
        background: #0a56c6;
        color: #fff;
      }

      .axis-step.active .axis-step-index {
        background: var(--axis-color);
        color: #fff;
      }

      .axis-step-name {
        color: #334155;
        font-size: 0.64rem;
        line-height: 1.15;
        font-weight: 600;
      }

      .axis-dot {
        width: 0.46rem;
        height: 0.46rem;
        border-radius: 999px;
        background: #d1d5db;
      }

      .axis-dot.done {
        background: var(--color-cobalt);
      }

      .axis-dot.current {
        background: var(--color-indigo);
      }

      .q-title {
        margin: 0.84rem 0 0.96rem;
        width: 100%;
        font-size: 1.02rem;
        line-height: 1.44;
        letter-spacing: -0.005em;
        text-wrap: wrap;
        color: #1a3b7a;
        font-weight: 500;
      }

      .opts {
        display: grid;
        gap: 0.62rem;
      }

      .opt-btn {
        width: 100%;
        border-radius: 0.72rem;
        border: 1px solid #d1d5db;
        background: #fff;
        color: var(--text-body);
        text-align: left;
        padding: 0.88rem 0.96rem;
        font-size: 0.94rem;
        line-height: 1.42;
        font-weight: 500;
        cursor: pointer;
        transition:
          transform 0.16s ease,
          box-shadow 0.16s ease,
          border-color 0.16s ease,
          background-color 0.16s ease;
      }

      .opt-btn:hover {
        border-color: var(--color-cobalt);
        background: #f8fbff;
        transform: translateY(-1px);
        box-shadow: 0 8px 18px rgba(1, 25, 99, 0.08);
      }

      .opt-btn.selected {
        border-color: var(--color-cobalt);
        background: var(--color-bone);
        color: var(--text-strong);
        font-weight: 500;
        box-shadow: 0 6px 14px rgba(10, 86, 198, 0.1);
      }

      .axis-modal-backdrop {
        position: fixed;
        inset: 0;
        z-index: 120;
        background: rgba(1, 25, 99, 0.38);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1rem;
      }

      .axis-modal {
        width: min(560px, calc(100vw - 2rem));
        background: #fff;
        border: 1px solid #dbeafe;
        border-radius: 1rem;
        box-shadow: 0 22px 50px rgba(1, 25, 99, 0.28);
        padding: 1rem 1rem 0.95rem;
      }

      .axis-modal-kicker {
        margin: 0;
        font-size: 0.72rem;
        letter-spacing: 0.08em;
        font-weight: 700;
        color: #0a56c6;
        text-transform: uppercase;
      }

      .axis-modal-title {
        margin: 0.45rem 0 0;
        font-size: 1.12rem;
        color: #011963;
        font-weight: 700;
      }

      .axis-modal-text {
        margin: 0.55rem 0 0;
        color: #334155;
        font-size: 0.93rem;
        line-height: 1.45;
      }

      .axis-modal-btn {
        margin-top: 0.9rem;
        width: 100%;
        border: 0;
        border-radius: 0.65rem;
        background: #0a56c6;
        color: #fff;
        font-weight: 700;
        font-size: 0.9rem;
        padding: 0.7rem 0.9rem;
        cursor: pointer;
      }

      .axis-modal-btn:hover {
        background: #011963;
      }

      .lead-gate-backdrop {
        position: fixed;
        inset: 0;
        z-index: 130;
        background: rgba(1, 25, 99, 0.44);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1rem;
      }

      .lead-gate-card {
        width: min(560px, calc(100vw - 2rem));
        background: #fff;
        border: 1px solid #dbeafe;
        border-radius: 1rem;
        box-shadow: 0 24px 48px rgba(1, 25, 99, 0.25);
        padding: 1rem;
      }

      .lead-gate-title {
        margin: 0;
        font-size: 1.1rem;
        color: #011963;
        font-weight: 700;
      }

      .lead-gate-sub {
        margin: 0.38rem 0 0.78rem;
        color: #475569;
        font-size: 0.9rem;
        line-height: 1.42;
      }

      .lead-input {
        width: 100%;
        border: 1px solid #cbd5e1;
        border-radius: 0.65rem;
        padding: 0.68rem 0.78rem;
        font-size: 0.9rem;
        margin-bottom: 0.52rem;
      }

      .lead-input:focus {
        outline: none;
        border-color: #0a56c6;
        box-shadow: 0 0 0 2px rgba(10, 86, 198, 0.1);
      }

      .lead-error {
        color: #b93d3d;
        font-size: 0.78rem;
        font-weight: 600;
        margin: 0.15rem 0 0.5rem;
      }

      .lead-gate-actions {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.48rem;
      }

      .download-row {
        margin-top: 0.8rem;
      }

      .back-row {
        margin-top: 0.95rem;
      }

      .back-btn {
        background: transparent;
        border: 0;
        color: var(--text-muted);
        font-size: 0.8rem;
        font-weight: 500;
        cursor: pointer;
      }

      .tabs {
        display: flex;
        gap: 0.32rem;
        margin-bottom: 0.9rem;
      }

      .tab-btn {
        flex: 1;
        border: 1px solid #d1d5db;
        background: #fff;
        color: #6b7280;
        border-radius: 0.65rem;
        padding: 0.6rem 0.35rem;
        font-size: 0.78rem;
        font-weight: 700;
        cursor: pointer;
      }

      .tab-btn.active {
        border-color: var(--color-cobalt);
        color: #fff;
        background: var(--color-cobalt);
      }

      .result-card {
        padding: 1rem;
      }

      .scan-note {
        margin: 0 0 0.75rem;
        color: #64748b;
        font-size: 0.8rem;
        font-weight: 600;
      }

      .axis-scan-list {
        display: grid;
        gap: 0.62rem;
      }

      .axis-scan-item {
        border: 1px solid #e2e8f0;
        border-radius: 0.8rem;
        background: #fff;
        padding: 0.68rem 0.75rem 0.72rem;
      }

      .axis-scan-item.critical {
        border-color: #fecaca;
        background: #fffdfd;
      }

      .axis-scan-head {
        display: grid;
        grid-template-columns: auto 1fr auto;
        align-items: center;
        gap: 0.55rem;
      }

      .axis-icon {
        font-size: 1rem;
        line-height: 1;
      }

      .axis-name-block {
        min-width: 0;
      }

      .axis-name {
        margin: 0;
        color: #0f172a;
        font-size: 0.95rem;
        font-weight: 700;
        line-height: 1.2;
      }

      .axis-meta {
        margin: 0.16rem 0 0;
        color: #64748b;
        font-size: 0.78rem;
        font-weight: 600;
      }

      .axis-score-wrap {
        display: flex;
        align-items: center;
        gap: 0.4rem;
      }

      .axis-score {
        color: #0f172a;
        font-size: 0.92rem;
        font-weight: 700;
      }

      .crit-chip {
        display: inline-flex;
        align-items: center;
        border-radius: 999px;
        background: #b93d3d;
        color: #fff;
        font-size: 0.62rem;
        font-weight: 700;
        padding: 0.12rem 0.42rem;
      }

      .axis-scan-bar {
        margin-top: 0.52rem;
        width: 100%;
        height: 0.42rem;
        border-radius: 999px;
        overflow: hidden;
        background: #e5e7eb;
      }

      .axis-scan-fill {
        height: 100%;
        border-radius: 999px;
        background: #0a56c6;
      }

      .axis-scan-fill.critical {
        background: #b93d3d;
      }

      .axis-phrase {
        margin: 0.52rem 0 0;
        color: #334155;
        font-size: 0.84rem;
        line-height: 1.38;
      }

      .impact-hero {
        border: 1px solid #dbeafe;
        background: #f8fbff;
        border-radius: 0.82rem;
        padding: 0.8rem 0.9rem;
        text-align: center;
      }

      .impact-main {
        margin: 0.28rem 0 0;
        color: #011963;
        font-size: 2rem;
        font-weight: 700;
        line-height: 1.05;
      }

      .impact-sub {
        margin: 0.12rem 0 0;
        color: #64748b;
        font-size: 0.86rem;
        font-weight: 600;
      }

      .impact-pill {
        display: inline-block;
        margin-top: 0.52rem;
        border-radius: 999px;
        background: #b93d3d;
        color: #fff;
        padding: 0.2rem 0.62rem;
        font-size: 0.78rem;
        font-weight: 700;
      }

      .impact-list {
        margin-top: 0.78rem;
        display: grid;
        gap: 0.34rem;
      }

      .impact-item {
        border: 1px solid #e5e7eb;
        border-radius: 0.7rem;
        background: #fff;
        padding: 0.5rem 0.56rem;
      }

      .impact-item-head {
        display: grid;
        grid-template-columns: 1.5rem auto 1fr auto;
        gap: 0.48rem;
        align-items: center;
      }

      .rank-badge {
        width: 1.24rem;
        height: 1.24rem;
        border-radius: 999px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #e2e8f0;
        color: #475569;
        font-size: 0.68rem;
        font-weight: 700;
      }

      .rank-badge.top {
        background: #0a56c6;
        color: #fff;
      }

      .impact-axis {
        color: #0f172a;
        font-size: 0.86rem;
        font-weight: 700;
      }

      .impact-amount {
        text-align: right;
      }

      .impact-amount .money {
        display: block;
        color: #0f172a;
        font-size: 0.84rem;
        font-weight: 700;
      }

      .impact-amount .pct {
        display: block;
        color: #64748b;
        font-size: 0.7rem;
        font-weight: 600;
      }

      .impact-mini-track {
        margin-top: 0.36rem;
        width: 100%;
        height: 0.3rem;
        border-radius: 999px;
        overflow: hidden;
        background: #e5e7eb;
      }

      .impact-mini-fill {
        height: 100%;
        border-radius: 999px;
        background: #94a3b8;
      }

      .impact-mini-fill.top {
        background: #0a56c6;
      }

      .center {
        text-align: center;
      }

      .level-hover-hint {
        margin: 0.45rem 0 0;
        color: #64748b;
        font-size: 0.74rem;
        font-weight: 600;
      }

      .skyline-wrap {
        margin-top: 0.35rem;
        display: flex;
        align-items: flex-end;
        justify-content: center;
        gap: 0.68rem;
        min-height: 5.3rem;
      }

      .skyline-level {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        outline: none;
      }

      .skyline-bars {
        display: flex;
        align-items: flex-end;
        gap: 2px;
      }

      .skyline-level-index {
        margin-top: 4px;
        font-size: 10px;
        font-weight: 700;
      }

      .skyline-tooltip {
        position: absolute;
        left: 50%;
        bottom: calc(100% + 9px);
        transform: translateX(-50%) translateY(4px);
        width: min(260px, 70vw);
        background: #0f172a;
        color: #fff;
        border-radius: 0.65rem;
        padding: 0.52rem 0.58rem;
        box-shadow: 0 18px 34px rgba(2, 6, 23, 0.34);
        opacity: 0;
        pointer-events: none;
        transition:
          opacity 0.2s ease,
          transform 0.2s ease;
        z-index: 6;
      }

      .skyline-level:hover .skyline-tooltip,
      .skyline-level:focus-visible .skyline-tooltip,
      .skyline-level:focus-within .skyline-tooltip,
      .skyline-level:active .skyline-tooltip {
        opacity: 1;
        transform: translateX(-50%) translateY(0);
      }

      .skyline-tooltip-title {
        margin: 0;
        font-size: 0.72rem;
        line-height: 1.2;
        font-weight: 700;
      }

      .skyline-tooltip-copy {
        margin: 0.28rem 0 0;
        font-size: 0.72rem;
        line-height: 1.34;
        color: #dbeafe;
      }

      .city-analogy-box {
        margin-top: 0.62rem;
        border: 1px solid #dbeafe;
        background: #f8fbff;
        border-radius: 0.75rem;
        padding: 0.62rem 0.66rem;
        text-align: left;
      }

      .city-analogy-kicker {
        margin: 0;
        color: #0a56c6;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
      }

      .city-analogy-copy {
        margin: 0.32rem 0 0;
        color: #334155;
        font-size: 0.82rem;
        line-height: 1.46;
        font-weight: 500;
      }

      .score-pill {
        display: inline-block;
        margin-top: 0.65rem;
        padding: 0.26rem 0.74rem;
        border-radius: 999px;
        color: #fff;
        font-size: 0.82rem;
        font-weight: 700;
        background: var(--color-danger);
      }

      .big-number {
        margin: 0;
        font-size: 2.1rem;
        color: var(--color-indigo);
        font-weight: 700;
      }

      .muted {
        color: #6b7280;
      }

      .axis-row {
        display: grid;
        grid-template-columns: 1.1rem 1fr 3rem;
        gap: 0.6rem;
        align-items: center;
        margin: 0.55rem 0;
      }

      .bar-track {
        width: 100%;
        height: 0.68rem;
        background: #e5e7eb;
        border-radius: 999px;
        overflow: hidden;
      }

      .bar-fill {
        height: 100%;
      }

      .axis-box {
        margin-top: 0.85rem;
        border: 1px solid #e5e7eb;
        border-left: 4px solid var(--color-cobalt);
        border-radius: 0.75rem;
        padding: 0.7rem 0.75rem;
        background: #fff;
      }

      .axis-box h4 {
        margin: 0;
        color: var(--color-indigo);
        font-size: 0.92rem;
      }

      .axis-box p {
        margin: 0.4rem 0 0;
        font-size: 0.84rem;
        line-height: 1.4;
        color: #4b5563;
      }

      .impact-row {
        display: grid;
        grid-template-columns: 1.2rem 1fr auto;
        gap: 0.58rem;
        align-items: center;
        padding: 0.48rem 0;
        border-bottom: 1px solid #eef2f7;
      }

      .impact-row:last-child {
        border-bottom: 0;
      }

      .callout {
        margin-top: 0.85rem;
        border-radius: 0.75rem;
        padding: 0.75rem;
        background: #f8fafc;
        border: 1px solid #dbeafe;
        font-size: 0.85rem;
        line-height: 1.48;
        color: #334155;
      }

      .callout.success {
        background: #ecfdf5;
        border-color: #a7f3d0;
      }

      .cta-stack {
        margin-top: 0.95rem;
        display: grid;
        gap: 0.55rem;
      }

      @media (max-width: 640px) {
        .title {
          font-size: 1.5rem;
        }

        .q-title {
          font-size: 0.91rem;
          line-height: 1.5;
        }

        .screen {
          padding-top: 6.2rem;
        }

        .question-stage {
          min-height: calc(100vh - 8.2rem);
        }

        .question-stage .question-wrap {
          margin-top: 2rem;
        }

        .axis-stepper {
          display: flex;
          overflow-x: auto;
          padding-bottom: 0.22rem;
          scrollbar-width: thin;
        }

        .axis-step {
          min-width: 6.8rem;
          flex: 0 0 auto;
        }

        .skyline-tooltip {
          width: min(220px, 78vw);
        }

        #brand-logo {
          height: 2rem;
        }
      }
    </style>
  </head>
  <body>
    <div class="app-shell">
      <header
        class="absolute top-3 md:top-4 left-0 w-full p-4 md:p-5 z-50 flex justify-center items-center pointer-events-none"
      >
        <div
          class="pointer-events-auto transition-transform hover:scale-105 duration-300"
        >
          <img
            id="brand-logo"
            src="Group 17 (1).png"
            alt="Astrolab Logo"
            class="h-8 md:h-10 w-auto object-contain transition-opacity duration-300"
          />
        </div>

        <button
          id="lang-toggle-btn"
          data-action="toggle-lang"
          class="absolute right-6 pointer-events-auto bg-white/20 backdrop-blur-sm border border-white/30 text-[#011963] font-bold py-2 px-4 rounded-full text-xs hover:bg-white hover:shadow-lg transition-all z-50 cursor-pointer"
        >
          ES / <span class="opacity-50">EN</span>
        </button>
      </header>

      <main id="app-root" class="screen"></main>

      <form
        name="bas_stress_test"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        hidden
      >
        <input type="hidden" name="form-name" value="bas_stress_test" />
        <p hidden>
          <label>Don't fill this out if you're human: <input name="bot-field" /></label>
        </p>
        <input type="hidden" name="lead_name" value="" />
        <input type="hidden" name="lead_email" value="" />
        <input type="hidden" name="lead_company" value="" />
        <input type="hidden" name="res_score_efficiency" value="" />
        <input type="hidden" name="res_financial_impact" value="" />
        <input type="hidden" name="last_step_reached" value="" />
        <input type="hidden" name="device_type" value="" />
        <input type="hidden" name="geo_city" value="" />
        <input type="hidden" name="geo_country" value="" />
      </form>
    </div>

    <script type="module" src="./app-logic.js"></script>
  </body>
</html>
